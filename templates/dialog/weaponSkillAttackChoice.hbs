<form class="weapon-skill-attack-dialog">
    <section class="weapon-skill-attack-dialog__top-row">
        <div class="weapon-skill-attack-dialog__choices">
            <div class="weapon-skills-cards weapon-skills-cards--attack-choice weapon-skill-attack-dialog__standard-choice">
                <article class="weapon-skills-card weapon-skills-card--choice weapon-skills-card--standard">
                    <input
                        class="weapon-skills-card__radio"
                        type="radio"
                        name="selectedAttack"
                        id="weapon-attack-choice-standard"
                        value="standard"
                        {{checked weapon.checked}}
                    >
                    <label
                        class="weapon-skills-card__open"
                        for="weapon-attack-choice-standard"
                        title="{{localize 'WTTRPGEnhancements.WeaponSkillAttack.StandardHint'}}"
                    >
                        <span class="weapon-skills-card__art">
                            <img class="weapon-skills-card__image" src="{{weapon.img}}" alt="{{weapon.name}}">
                            <span class="weapon-skills-card__standard-badge" aria-hidden="true">
                                <i class="fas fa-sword"></i>
                            </span>
                        </span>
                        <span class="weapon-skills-card__name">{{weapon.name}}</span>
                    </label>
                </article>
            </div>

            <div class="weapon-skill-attack-dialog__divider" aria-hidden="true">
                <span>{{localize "WTTRPGEnhancements.WeaponSkillAttack.Or"}}</span>
            </div>

            <div class="weapon-skill-attack-dialog__skill-groups">
                <section class="weapon-skill-attack-dialog__skill-group">
                    <h3 class="weapon-skill-attack-dialog__group-title">
                        {{localize "WTTRPGEnhancements.WeaponSkillAttack.WeaponSkills"}}
                    </h3>
                    <div class="weapon-skills-cards weapon-skills-cards--attack-choice weapon-skill-attack-dialog__skill-choices" data-available-skills>
                        {{#each skillChoices}}
                        <article
                            class="weapon-skills-card weapon-skills-card--choice weapon-skills-card--conditional"
                            data-condition-matches="{{this.available}}"
                            {{#unless this.available}}hidden{{/unless}}
                        >
                            <input
                                class="weapon-skills-card__radio"
                                type="radio"
                                name="selectedAttack"
                                id="weapon-skill-choice-{{this.id}}"
                                value="{{this.id}}"
                                {{checked this.checked}}
                                {{#unless this.available}}disabled{{/unless}}
                            >
                            <label class="weapon-skills-card__open" for="weapon-skill-choice-{{this.id}}" title="{{this.name}}">
                                <span class="weapon-skills-card__art">
                                    <img class="weapon-skills-card__image" src="{{this.img}}" alt="{{this.name}}">
                                </span>
                                <span class="weapon-skills-card__name">{{this.name}}</span>
                            </label>
                            <button
                                type="button"
                                class="weapon-skills-card__info"
                                data-skill-uuid="{{this.uuid}}"
                                title="{{localize 'WTTRPGEnhancements.WeaponSkillAttack.MoreInfo'}}"
                            >
                                <i class="fas fa-circle-info"></i>
                            </button>
                        </article>
                        {{/each}}
                    </div>
                </section>

            </div>
        </div>
    </section>

    <div class="weapon-skill-attack-dialog__condition-controls">
        <label class="weapon-skill-attack-dialog__condition-control">
            <input type="checkbox" data-show-all-skills>
            <span>
                <strong>{{localize "WTTRPGEnhancements.WeaponSkillAttack.ShowAllSkills"}}</strong>
                <small>{{localize "WTTRPGEnhancements.WeaponSkillAttack.ShowAllSkillsHint"}}</small>
            </span>
        </label>
    </div>
</form>
