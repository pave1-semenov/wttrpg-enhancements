<div class="apply-damage-dialog">
    <h1>{{localize "WTTRPGEnhancements.ApplyDamage.Title"}}</h1>
    <table class="apply-damage-table">
        <tr>
            <td><label>{{localize "WTTRPGEnhancements.ApplyDamage.RolledAmount"}}</label></td>
            <td><b>{{totalDamage}}</b></td>
        </tr>
        <tr>
            <td><label for="damage-modifier-type">{{localize "WTTRPGEnhancements.ApplyDamage.ModifierType"}}</label></td>
            <td>
                <select id="damage-modifier-type" name="damageModifierType">
                    <option value="none">{{localize "WTTRPGEnhancements.ApplyDamage.NoModifier"}}</option>
                    <option value="fixed">{{localize "WTTRPGEnhancements.ApplyDamage.FixedAmount"}}</option>
                    <option value="percentage">{{localize "WTTRPGEnhancements.ApplyDamage.Percentage"}}</option>
                </select>
            </td>
        </tr>
        <tr>
            <td><label for="damage-modifier">{{localize "WTTRPGEnhancements.ApplyDamage.Modifier"}}</label></td>
            <td><input id="damage-modifier" type="number" name="damageModifier" value="0" step="any" /></td>
        </tr>
        <tr>
            <td>
                <label>{{localize "WITCHER.Damage.damageType" }}</label>
            </td>
            <td>
                <b>{{localize damageType }}</b>
            </td>
        </tr>
        <tr>
            <td>
                <label>{{localize "WITCHER.Context.applyNonLethal" }}</label>
            </td>
            <td>
                <input type="checkbox" name="nonLethal" />
            </td>
        </tr>
        <tr>
            <td>
                <label>{{localize "WITCHER.Damage.CurrentLocation" }}</label>
            </td>
            <td><select name="location">
                    {{selectOptions locations selected=location localize=true}}
                </select></td>
        </tr>
        <tr>
            <td>
                <label for="temporary-sp-bonus">{{localize "WTTRPGEnhancements.ApplyDamage.TemporarySpBonus"}}</label>
            </td>
            <td>
                <input id="temporary-sp-bonus" type="number" name="temporarySpBonus" value="0" min="0" step="1" />
            </td>
        </tr>
        <tr>
            <td>
                <label>{{localize "WITCHER.Damage.isVulnerable" }}</label>
            </td>
            <td>
                <input type="checkbox" name="vulnerable" />
            </td>
        </tr>
        <tr>
            <td>
                <label>{{localize "WITCHER.Damage.oilDmg" }}</label>
            </td>
            <td>
                <input type="checkbox" name="oilDmg" />
            </td>
        </tr>
        {{#if isMonster}}
        <tr>
            <td>
                <label>{{localize "WITCHER.Damage.resistNonSilver" }}</label>
            </td>
            <td>
                <input type="checkbox" name="resistNonSilver" {{checked resistNonSilver}} />
            </td>
        </tr>
        <tr>
            <td>
                <label>{{localize "WITCHER.Damage.resistNonMeteorite" }}</label>
            </td>
            <td>
                <input type="checkbox" name="resistNonMeteorite" {{checked resistNonMeteorite}} />
            </td>
        </tr>
        {{/if}}
    </table>
</div>