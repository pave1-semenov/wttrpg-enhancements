<section class="situational-bonuses-dialog">
    <h2><i class="fas fa-sparkles"></i> {{localize "WTTRPGEnhancements.SituationalBonus.Available"}}</h2>
    <div class="situational-bonus-cards">
        {{#each bonuses}}
        <label class="situational-bonus-card situational-bonus-card--{{this.imageLayout}}" style="--bonus-image: url('{{this.img}}')">
            <input type="checkbox" data-situational-bonus data-scope="{{this.scope}}" data-formula="{{this.formula}}">
            <img class="situational-bonus-card__image" src="{{this.img}}" alt="{{this.name}}">
            <span class="situational-bonus-card__content">
                <strong>{{this.name}}</strong>
                <span class="situational-bonus-card__badges">
                    <span class="situational-bonus-card__badge situational-bonus-card__badge--{{this.scope}}">{{this.scopeLabel}}</span>
                    <span class="situational-bonus-card__badge situational-bonus-card__badge--{{this.origin}}">{{this.originLabel}}</span>
                    <span class="situational-bonus-card__badge situational-bonus-card__badge--formula" title="{{localize 'WTTRPGEnhancements.SituationalBonus.FormulaHint' scope=this.scopeLabel}}">{{localize "WTTRPGEnhancements.SituationalBonus.BonusLabel"}}: <code>{{this.formula}}</code></span>
                </span>
                {{#if this.description}}
                <span class="situational-bonus-card__description">{{{this.description}}}</span>
                <button type="button" class="situational-bonus-card__description-button" data-bonus-description-open aria-haspopup="dialog">{{localize "WTTRPGEnhancements.SituationalBonus.ShowMore"}}</button>
                {{/if}}
            </span>
        </label>
        {{/each}}
    </div>
</section>
